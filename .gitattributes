# 默认自动识别文本文件
* text=auto

# 跨平台文本使用 LF；GNU 校验清单不能带行尾回车
.gitattributes text eol=lf
**/SHA256SUMS.txt text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 图像、字体与其他二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.rgb565 binary
*.ttf binary
*.otf binary
*.bin binary

# 大型离线地图使用 Git LFS，禁止普通文本换行转换
Software/Lvgl_Project/assets/maps/**/*.btiles filter=lfs diff=lfs merge=lfs -text
Software/Lvgl_Project/assets/maps/**/*.bmap filter=lfs diff=lfs merge=lfs -text
Software/Lvgl_Project/assets/maps/**/*.bgraph filter=lfs diff=lfs merge=lfs -text
Software/Lvgl_Project/assets/maps/**/*.bpoi filter=lfs diff=lfs merge=lfs -text
