{
    "version": 6,
    "configurePresets": [
        {
            "name": "bike-ui",
            "displayName": "Bike UI - portable GCC/Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "bike-ui-ucrt64",
            "displayName": "Bike UI - Anaconda MSYS2 UCRT64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "D:/Professional Software/Anaconda/Bike_SpeedView/msys2-x86_64/ucrt64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "D:/Professional Software/Anaconda/Bike_SpeedView/msys2-x86_64/ucrt64/bin/g++.exe",
                "CMAKE_MAKE_PROGRAM": "D:/Professional Software/Anaconda/Bike_SpeedView/msys2-x86_64/ucrt64/bin/ninja.exe"
            },
            "environment": {
                "PATH": "D:/Professional Software/Anaconda/Bike_SpeedView/msys2-x86_64/ucrt64/bin;D:/Professional Software/Anaconda/Bike_SpeedView/msys2-x86_64/usr/bin;$penv{PATH}"
            }
        },
        {
            "name": "bike-ui-stm32-host",
            "displayName": "STM32 UI contract check on existing host compiler",
            "inherits": "bike-ui-ucrt64",
            "binaryDir": "${sourceDir}/build-stm32-host",
            "cacheVariables": {
                "UI_PLATFORM": "STM32",
                "UI_BOARD_CONTRACT_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "bike-ui",
            "configurePreset": "bike-ui"
        },
        {
            "name": "bike-ui-ucrt64",
            "configurePreset": "bike-ui-ucrt64"
        },
        {
            "name": "bike-ui-stm32-host",
            "configurePreset": "bike-ui-stm32-host"
        }
    ],
    "testPresets": [
        {
            "name": "bike-ui",
            "configurePreset": "bike-ui",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "bike-ui-ucrt64",
            "configurePreset": "bike-ui-ucrt64",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "bike-ui-stm32-host",
            "configurePreset": "bike-ui-stm32-host",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
