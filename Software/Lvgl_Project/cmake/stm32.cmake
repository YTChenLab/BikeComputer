# This target is a HAL-free static UI library, not STM32 firmware.
set(CMAKE_C_EXTENSIONS OFF)
set(LV_CONF_PATH "${PROJECT_SOURCE_DIR}/config/stm32/lv_conf.h")
set(LV_CONF_BUILD_DISABLE_EXAMPLES ON)
set(LV_CONF_BUILD_DISABLE_DEMOS ON)
if(USE_FREERTOS)
    message(FATAL_ERROR "STM32 FreeRTOS comes from the board project, never the POSIX simulator")
endif()
include(${PROJECT_SOURCE_DIR}/cmake/ui_sources.cmake)
foreach(font IN LISTS UI_GENERATED_FONT_NAMES)
    if(NOT EXISTS "${PROJECT_SOURCE_DIR}/src/ui/fonts/ui_font_misans_${font}.c")
        message(FATAL_ERROR "Generate and commit UI fonts using the PC target before the STM32 build")
    endif()
endforeach()
add_subdirectory(lvgl)
# Disabled desktop drivers are excluded from the manifest as well as lv_conf.
get_target_property(UI_LVGL_BOARD_SOURCES lvgl SOURCES)
list(FILTER UI_LVGL_BOARD_SOURCES EXCLUDE REGEX "/src/drivers/(sdl|windows|glfw|x11|wayland|evdev|libinput|qnx|nuttx|display/(drm|fb))/")
list(FILTER UI_LVGL_BOARD_SOURCES EXCLUDE REGEX "/src/draw/(sdl|opengles)/")
list(FILTER UI_LVGL_BOARD_SOURCES EXCLUDE REGEX "/src/draw/sw/blend/(neon|helium)/")
list(FILTER UI_LVGL_BOARD_SOURCES EXCLUDE REGEX "/src/libs/(tiny_ttf|ffmpeg)/")
list(FILTER UI_LVGL_BOARD_SOURCES EXCLUDE REGEX "/src/libs/fsdrv/lv_fs_(posix|stdio|win32)\\.c$")
list(FILTER UI_LVGL_BOARD_SOURCES EXCLUDE REGEX "/src/osal/lv_(pthread|windows|freertos|cmsis_rtos2|rtthread|mqx)\\.c$")
set_property(TARGET lvgl PROPERTY SOURCES ${UI_LVGL_BOARD_SOURCES})
target_include_directories(lvgl PUBLIC ${PROJECT_SOURCE_DIR}/src ${PROJECT_SOURCE_DIR})
target_compile_definitions(lvgl PUBLIC UI_TARGET_STM32=1)
file(GLOB UI_STM32_SOURCES CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/platform/stm32/*.c")
add_library(bike_ui_stm32 STATIC ${UI_CORE_SOURCES} ${UI_STM32_SOURCES})
target_include_directories(bike_ui_stm32 PUBLIC ${PROJECT_SOURCE_DIR}/src ${PROJECT_SOURCE_DIR})
target_link_libraries(bike_ui_stm32 PUBLIC lvgl lvgl::thorvg)
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang|ARMClang")
    target_compile_options(bike_ui_stm32 PRIVATE -O1 -Wall -Wextra -Wframe-larger-than=1024)
endif()
option(UI_BOARD_CONTRACT_TESTS "Run board ports with in-memory host mocks" OFF)
if(UI_BOARD_CONTRACT_TESTS)
    enable_testing()
    add_executable(ui_stm32_board_test tests/ui_stm32_board_test.c)
    target_link_libraries(ui_stm32_board_test PRIVATE bike_ui_stm32)
    if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
        target_link_libraries(ui_stm32_board_test PRIVATE m)
    endif()
    add_test(NAME ui_stm32_board_test COMMAND ui_stm32_board_test)
endif()
