set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR cortex-m7)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(UI_ARMCLANG_ROOT "" CACHE PATH "Existing Arm Compiler 6 installation root")
if(NOT EXISTS "${UI_ARMCLANG_ROOT}/bin/armclang.exe")
    message(FATAL_ERROR "Set UI_ARMCLANG_ROOT to the existing ARM/ARMCLANG directory")
endif()
set(CMAKE_C_COMPILER "${UI_ARMCLANG_ROOT}/bin/armclang.exe")
set(CMAKE_CXX_COMPILER "${UI_ARMCLANG_ROOT}/bin/armclang.exe")
set(CMAKE_ASM_COMPILER "${UI_ARMCLANG_ROOT}/bin/armclang.exe")
set(UI_ARM_ARCHIVER "${UI_ARMCLANG_ROOT}/bin/armar.exe" CACHE FILEPATH "Existing ARM ELF compatible archiver")
set(CMAKE_AR "${UI_ARM_ARCHIVER}")
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/armclang_rules.cmake")
set(CMAKE_LINKER "${UI_ARMCLANG_ROOT}/bin/armlink.exe")
# Some AC6 installations do not add their C11 resource headers automatically.
file(GLOB UI_ATOMIC_HEADERS "${UI_ARMCLANG_ROOT}/lib/clang/*/include/stdatomic.h")
if(NOT UI_ATOMIC_HEADERS)
    message(FATAL_ERROR "This compiler installation does not provide stdatomic.h")
endif()
list(GET UI_ATOMIC_HEADERS 0 UI_ATOMIC_HEADER)
get_filename_component(UI_CLANG_RESOURCE_INCLUDE "${UI_ATOMIC_HEADER}" DIRECTORY)
set(UI_ARM_CPU_FLAGS "--target=arm-arm-none-eabi -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT "${UI_ARM_CPU_FLAGS} -isystem \"${UI_CLANG_RESOURCE_INCLUDE}\"")
set(CMAKE_CXX_FLAGS_INIT "${UI_ARM_CPU_FLAGS} -isystem \"${UI_CLANG_RESOURCE_INCLUDE}\"")
set(CMAKE_ASM_FLAGS_INIT "${UI_ARM_CPU_FLAGS}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES UI_ARMCLANG_ROOT)
