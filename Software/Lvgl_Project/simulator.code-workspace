{
    "folders": [
        {
            "path": "."
        }
    ],

    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools",
            "ms-vscode.cpptools-themes",
            "ms-vscode.cmake-tools"
        ],
        "unwantedRecommendations": []
    },

    "settings": {
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,

        "files.associations": {
            "glob.h": "c",
            "lvgl.h": "c"
        },

        "cmake.configureOnOpen": false,

        "cmake.cmakePath": "D:/Professional Software/Anaconda/Bike_SpeedView/msys2-x86_64/ucrt64/bin/cmake.exe",

        "cmake.generator": "Ninja",

        "cmake.sourceDirectory": "${workspaceFolder}",

        "cmake.buildDirectory": "${workspaceFolder}/build",

        "cmake.environment": {
            "PATH": "D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\bin;${env:PATH}",
            "PKG_CONFIG_PATH": "D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\lib\\pkgconfig;D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\share\\pkgconfig"
