    "tasks": {
        "version": "2.0.0",

        "tasks": [
            {
                "label": "Build LVGL",
                "type": "process",
                "command": "D:/Professional Software/Anaconda/Bike_SpeedView/msys2-x86_64/ucrt64/bin/cmake.exe",
                "args": [
                    "--build",
                    "${workspaceFolder}/build",
                    "--parallel"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\bin;${env:PATH}",
                        "PKG_CONFIG_PATH": "D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\lib\\pkgconfig;D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\share\\pkgconfig"
                    }
                },
                "group": {
                    "kind": "build",
                    "isDefault": true
                },
                "problemMatcher": [
                    "$gcc"
                ],
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "dedicated",
                    "showReuseMessage": true,
                    "clear": true
                }
            },
            {
                "label": "Run LVGL Simulator",
                "type": "process",
                "command": "${workspaceFolder}/bin/main.exe",
                "dependsOn": [
                    "Build LVGL"
                ],
                "dependsOrder": "sequence",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\bin;${env:PATH}",
                        "PKG_CONFIG_PATH": "D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\lib\\pkgconfig;D:\\Professional Software\\Anaconda\\Bike_SpeedView\\msys2-x86_64\\ucrt64\\share\\pkgconfig"
                    }
                },
                "problemMatcher": [],
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "dedicated",
                    "showReuseMessage": true,
                    "clear": false
                }
            }
        ]
    },

    "launch": {
        "version": "0.2.0",

        "configurations": [
            {
                "name": "LVGL Simulator",

                "type": "cppdbg",

                "request": "launch",

                "program": "${workspaceFolder}/bin/main.exe",

                "args": [],

